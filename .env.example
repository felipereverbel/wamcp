# ============================================================
# WA MCP — Environment Variables (hardened defaults)
# ============================================================

# REQUIRED in production: bearer/API key for /mcp and detailed /health
WA_MCP_API_KEY=
# Refuse to start HTTP mode without WA_MCP_API_KEY when true (also implied by NODE_ENV=production)
WA_REQUIRE_API_KEY=true

# Transport mode: "http" (Streamable HTTP) or "stdio" (local dev)
WA_TRANSPORT=http

# HTTP port (Railway also sets PORT — the server honors PORT first)
WA_MCP_PORT=3000

# Redis connection URL (required for BullMQ queues)
WA_REDIS_URL=redis://localhost:6379

# Prefer warn in production to reduce chat leakage via logs
WA_LOG_LEVEL=warn

# Days to keep messages before auto-pruning (stored on the server volume)
WA_MESSAGE_RETENTION_DAYS=14

# Max messages/minute per Baileys instance
WA_BAILEYS_RATE_LIMIT=20

# Max messages/minute per Cloud API instance
WA_CLOUD_RATE_LIMIT=80

# Baileys full history sync (default OFF). When false, chat *list* metadata is
# still persisted from chats.upsert / messaging-history chat stubs; message bodies
# from history events are capped by WA_HISTORY_MAX_* below.
# When true, Baileys requests full history (heavier network + storage). Message
# persist is still bounded by WA_HISTORY_MAX_* as a safety cap.
WA_SYNC_FULL_HISTORY=false

# Max messages to persist per chat from messaging-history.set (default 50)
WA_HISTORY_MAX_MESSAGES_PER_CHAT=50

# Ignore history messages older than this many days (default 30)
WA_HISTORY_MAX_AGE_DAYS=30

# Meta webhook verification token (Cloud API)
# WA_CLOUD_WEBHOOK_SECRET=your_meta_webhook_secret

# Separate port for Cloud API webhook receiver
WA_CLOUD_WEBHOOK_PORT=3001

# Max media cache size in MB before cleanup
WA_MEDIA_CACHE_MAX_MB=500

# Auto-reconnect Baileys instances on disconnect
WA_AUTO_RECONNECT=true

# Daily WhatsApp Web version auto-check (Baileys helper; not your chat content)
WA_VERSION_CHECK=true
